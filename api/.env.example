# AI Narration - Groq (Cloud Hosted Open-Weight Models)
# Recommended: gemma2-9b-it (Google Gemma 2 - qualifies for $200 Gemma category)
# Alternative: openai/gpt-oss-120b or llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=gemma2-9b-it

# Offline AI Narration - Ollama (100% Local Inference, no internet required)
# e.g. OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=

# Atmospheric Ghost Audio - ElevenLabs (Qualifies for $100 ElevenLabs category)
# Optional: provide key for synthesized whisper voice audio
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Server Settings
API_PORT=4000
